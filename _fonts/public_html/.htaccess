# Do not remove this line, otherwise mod_rewrite rules will stop working
RewriteBase /


# DO NOT REMOVE THIS LINE AND THE LINES BELOW SSL_REDIRECT:terrybu.com
RewriteEngine on
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^terrybu.com$
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI}
# DO NOT REMOVE THIS LINE AND THE LINES ABOVE SSL_REDIRECT:terrybu.com
